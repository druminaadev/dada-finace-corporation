{
  "info": {
    "name": "Loan Management System API",
    "description": "Complete API collection for Loan Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Test User\",\n  \"phone\": \"9876543210\",\n  \"role\": \"EMPLOYEE\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["const response = pm.response.json();", "if (response.data && response.data.accessToken) {", "  pm.environment.set('access_token', response.data.accessToken);", "}"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@loanmanagement.com\",\n  \"password\": \"admin123\"\n}"
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/auth/profile"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"your_refresh_token_here\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{base_url}}/customers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"phone\": \"9876543210\",\n  \"address\": \"123 Main Street, City\",\n  \"aadhaar\": \"123456789012\",\n  \"pan\": \"ABCDE1234F\",\n  \"dob\": \"1990-01-01\"\n}"
            }
          }
        },
        {
          "name": "Get All Customers",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": {
              "raw": "{{base_url}}/customers?page=1&limit=10&search=&isActive=true",
              "host": ["{{base_url}}"],
              "path": ["customers"],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "limit", "value": "10"},
                {"key": "search", "value": ""},
                {"key": "isActive", "value": "true"}
              ]
            }
          }
        },
        {
          "name": "Get Customer by ID",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/customers/:id"
          }
        },
        {
          "name": "Update Customer",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{base_url}}/customers/:id",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe Updated\",\n  \"address\": \"456 New Street\"\n}"
            }
          }
        },
        {
          "name": "Delete Customer",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/customers/:id"
          }
        }
      ]
    },
    {
      "name": "Loans",
      "item": [
        {
          "name": "Create Loan",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{base_url}}/loans",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"customer-uuid-here\",\n  \"amount\": 100000,\n  \"interestRate\": 12,\n  \"tenure\": 12,\n  \"purpose\": \"Business expansion\"\n}"
            }
          }
        },
        {
          "name": "Get All Loans",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": {
              "raw": "{{base_url}}/loans?page=1&limit=10&status=PENDING",
              "host": ["{{base_url}}"],
              "path": ["loans"],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "limit", "value": "10"},
                {"key": "status", "value": "PENDING"}
              ]
            }
          }
        },
        {
          "name": "Get Loan by ID",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/loans/:id"
          }
        },
        {
          "name": "Update Loan",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{base_url}}/loans/:id",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 120000,\n  \"interestRate\": 11\n}"
            }
          }
        },
        {
          "name": "Approve Loan",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{base_url}}/loans/:id/approve",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"disbursedAt\": \"2024-01-01T00:00:00.000Z\"\n}"
            }
          }
        },
        {
          "name": "Reject Loan",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{base_url}}/loans/:id/reject",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rejectionReason\": \"Insufficient documentation\"\n}"
            }
          }
        },
        {
          "name": "Delete Loan",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/loans/:id"
          }
        }
      ]
    },
    {
      "name": "EMI",
      "item": [
        {
          "name": "Get EMI Calendar",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": {
              "raw": "{{base_url}}/emi/calendar?month=1&year=2024",
              "host": ["{{base_url}}"],
              "path": ["emi", "calendar"],
              "query": [
                {"key": "month", "value": "1"},
                {"key": "year", "value": "2024"}
              ]
            }
          }
        },
        {
          "name": "Get Upcoming EMIs",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": {
              "raw": "{{base_url}}/emi/upcoming?days=7",
              "host": ["{{base_url}}"],
              "path": ["emi", "upcoming"],
              "query": [{"key": "days", "value": "7"}]
            }
          }
        },
        {
          "name": "Get Overdue EMIs",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/emi/overdue"
          }
        },
        {
          "name": "Get EMIs by Loan",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/emi/loan/:loanId"
          }
        },
        {
          "name": "Pay EMI",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{base_url}}/emi/:id/pay",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 9000,\n  \"paymentMode\": \"BANK_TRANSFER\",\n  \"transactionId\": \"TXN123456789\",\n  \"remarks\": \"Monthly EMI payment\"\n}"
            }
          }
        },
        {
          "name": "Get Payment History",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/emi/:id/history"
          }
        }
      ]
    },
