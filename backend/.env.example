# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/drumina_loan?schema=public"
DATABASE_TEST_URL="postgresql://postgres:postgres@localhost:5432/drumina_loan_test?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_this_access_secret_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=change_this_refresh_secret_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Encryption (AES-256 for sensitive fields) ────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change_this_32_byte_hex_key_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# ─── Account Security ─────────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ─── AWS S3 / Compatible Storage ─────────────────────────────────────────────
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=ap-south-1
S3_BUCKET=drumina-loan-documents
S3_ACCESS_KEY=<your_s3_access_key>
S3_SECRET_KEY=<your_s3_secret_key>
S3_PRESIGN_EXPIRY_SECONDS=3600

# ─── Email (Nodemailer) ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<your_smtp_user>
SMTP_PASS=<your_smtp_password>
EMAIL_FROM="Drumina Loan Finance <noreply@druminafinance.com>"

# ─── SMS Provider ─────────────────────────────────────────────────────────────
SMS_PROVIDER=mock
SMS_API_URL=https://api.smsprovider.com/send
SMS_API_KEY=<your_sms_api_key>
SMS_SENDER_ID=DRUMINA

# ─── WhatsApp Provider ────────────────────────────────────────────────────────
WHATSAPP_PROVIDER=mock
WHATSAPP_API_URL=https://api.whatsapp.com/send
WHATSAPP_API_KEY=<your_whatsapp_api_key>
WHATSAPP_PHONE_ID=<your_phone_number_id>

# ─── Credit Score Provider ────────────────────────────────────────────────────
CREDIT_SCORE_PROVIDER=mock
CREDIT_SCORE_API_URL=https://api.creditscore.com
CREDIT_SCORE_API_KEY=<your_credit_score_api_key>

# ─── File Upload ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf

# ─── Seed Credentials (development only) ─────────────────────────────────────
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin@123!
SEED_ADMIN_PASSWORD=Admin@123456!
SEED_MANAGER_PASSWORD=Manager@123456!
SEED_OFFICER_PASSWORD=Officer@123456!
