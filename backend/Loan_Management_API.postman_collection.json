              "raw": "{\n  \"loanId\": \"loan-uuid-here\",\n  \"name\": \"Guarantor Name\",\n  \"phone\": \"9876543210\",\n  \"email\": \"guarantor@example.com\",\n  \"address\": \"Guarantor Address\",\n  \"relationship\": \"Friend\",\n  \"aadhaar\": \"123456789012\",\n  \"pan\": \"ABCDE1234F\"\n}"
            }
          }
        },
        {
          "name": "Get Guarantors by Loan",
          "request": {
            "method": "GET",
