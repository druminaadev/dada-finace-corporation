{
  "info": {
    "name": "Loan Application — 5-Stage Workflow",
    "_postman_id": "loan-app-5stage-v1",
    "description": "Complete 5-stage loan application API collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "draftId", "value": "" },
    { "key": "loanId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": ["const r = pm.response.json(); if(r.data?.accessToken) pm.collectionVariables.set('token', r.data.accessToken);"] } }],
          "request": {
            "method": "POST", "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@nexzen.com\",\n  \"password\": \"Admin@123\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Stage 1 — Aadhaar OTP",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/loan-application/otp/send",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"aadhaar\": \"123456789012\"\n}" }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/loan-application/otp/verify",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"aadhaar\": \"123456789012\",\n  \"otp\": \"123456\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Draft Management",
      "item": [
        {
          "name": "Create Draft",
          "event": [{ "listen": "test", "script": { "exec": ["const r = pm.response.json(); if(r.data?.id) pm.collectionVariables.set('draftId', r.data.id);"] } }],
          "request": {
            "method": "POST", "url": "{{baseUrl}}/loan-application/drafts",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" }
          }
        },
        {
          "name": "Get All Drafts",
          "request": {
            "method": "GET", "url": "{{baseUrl}}/loan-application/drafts",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Draft by ID",
          "request": {
            "method": "GET", "url": "{{baseUrl}}/loan-application/drafts/{{draftId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Stage Saves",
      "item": [
        {
          "name": "Save Stage 1 — Aadhaar Verified",
          "request": {
            "method": "PATCH", "url": "{{baseUrl}}/loan-application/drafts/{{draftId}}/stage/1",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"aadhaarVerified\": true,\n  \"aadhaarData\": {\n    \"aadhaar\": \"123456789012\",\n    \"name\": \"Ramesh Patel\",\n    \"dob\": \"1985-06-15\",\n    \"gender\": \"Male\",\n    \"phone\": \"9876501001\",\n    \"address\": \"45 Market Road, Ahmedabad\"\n  }\n}" }
          }
        },
        {
          "name": "Save Stage 2 — Customer & Loan Details",
          "request": {
            "method": "PATCH", "url": "{{baseUrl}}/loan-application/drafts/{{draftId}}/stage/2",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"customerDetails\": {\n    \"name\": \"Ramesh Patel\",\n    \"phone\": \"9876501001\",\n    \"altPhone\": \"9876501002\",\n    \"email\": \"ramesh@email.com\",\n    \"dob\": \"1985-06-15\",\n    \"age\": 39,\n    \"gender\": \"Male\",\n    \"maritalStatus\": \"Married\",\n    \"occupation\": \"Businessman\",\n    \"income\": 50000,\n    \"address\": \"45 Market Road, Ahmedabad\",\n    \"pan\": \"ABCDE1234F\",\n    \"fatherName\": \"Suresh Patel\",\n    \"bankAccountNo\": \"10234567890\",\n    \"bankHolderName\": \"Ramesh Patel\",\n    \"bankName\": \"SBI\",\n    \"bankBranch\": \"Navrangpura\",\n    \"bankIfsc\": \"SBIN0001234\"\n  },\n  \"loanDetails\": {\n    \"loanCategory\": \"PERSONAL\",\n    \"amount\": 100000,\n    \"interestRate\": 12,\n    \"interestType\": \"FLAT\",\n    \"tenure\": 12,\n    \"processingFee\": 500,\n    \"emiStartDate\": \"2025-08-01\",\n    \"purpose\": \"Business expansion\",\n    \"notes\": \"Regular customer\"\n  }\n}" }
          }
        },
        {
          "name": "Save Stage 3 — Guarantors & Nominees",
          "request": {
            "method": "PATCH", "url": "{{baseUrl}}/loan-application/drafts/{{draftId}}/stage/3",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"nominees\": [\n    {\n      \"name\": \"Sunita Patel\",\n      \"phone\": \"9876501003\",\n      \"relationship\": \"Spouse\",\n      \"aadhaar\": \"234567890123\",\n      \"address\": \"45 Market Road, Ahmedabad\",\n      \"occupation\": \"Homemaker\",\n      \"dob\": \"1988-03-20\"\n    }\n  ],\n  \"guarantors\": [\n    {\n      \"name\": \"Mahesh Patel\",\n      \"phone\": \"9876501004\",\n      \"relationship\": \"Brother\",\n      \"aadhaar\": \"345678901234\",\n      \"pan\": \"BCDEF2345G\",\n      \"address\": \"12 Gandhi Nagar, Ahmedabad\",\n      \"occupation\": \"Salaried\",\n      \"income\": 40000\n    }\n  ]\n}" }
          }
        },
        {
          "name": "Save Stage 4 — Document Metadata",
          "request": {
            "method": "PATCH", "url": "{{baseUrl}}/loan-application/drafts/{{draftId}}/stage/4",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"documentsUploaded\": [\n    { \"category\": \"aadhaar\", \"fileName\": \"aadhaar.pdf\" },\n    { \"category\": \"pan\", \"fileName\": \"pan.pdf\" },\n    { \"category\": \"photo\", \"fileName\": \"photo.jpg\" }\n  ]\n}" }
          }
        },
        {
          "name": "Upload Documents (multipart)",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/loan-application/drafts/{{draftId}}/documents",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "files", "type": "file", "src": [] },
                { "key": "category", "value": "aadhaar", "type": "text" },
                { "key": "entityType", "value": "CUSTOMER", "type": "text" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Final Submission",
      "item": [
        {
          "name": "Submit Draft (Final)",
          "event": [{ "listen": "test", "script": { "exec": ["const r = pm.response.json(); if(r.data?.loan?.id) pm.collectionVariables.set('loanId', r.data.loan.id);"] } }],
          "request": {
            "method": "POST", "url": "{{baseUrl}}/loan-application/drafts/{{draftId}}/submit",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Loan Status Management",
      "item": [
        {
          "name": "Move to Under Review",
          "request": {
            "method": "PATCH", "url": "{{baseUrl}}/loan-application/loans/{{loanId}}/status",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"UNDER_REVIEW\",\n  \"note\": \"Documents verified, moving to review\"\n}" }
          }
        },
        {
          "name": "Approve Loan",
          "request": {
            "method": "PATCH", "url": "{{baseUrl}}/loan-application/loans/{{loanId}}/status",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"APPROVED\",\n  \"note\": \"Loan approved by branch manager\"\n}" }
          }
        },
        {
          "name": "Disburse Loan",
          "request": {
            "method": "PATCH", "url": "{{baseUrl}}/loan-application/loans/{{loanId}}/status",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ACTIVE\",\n  \"note\": \"Funds disbursed to customer account\"\n}" }
          }
        },
        {
          "name": "Reject Loan",
          "request": {
            "method": "PATCH", "url": "{{baseUrl}}/loan-application/loans/{{loanId}}/status",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"REJECTED\",\n  \"note\": \"Insufficient income proof\"\n}" }
          }
        }
      ]
    }
  ]
}
