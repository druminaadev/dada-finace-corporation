          }
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "Upload Document",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/documents/upload",
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "file", "type": "file", "src": ""},
                {"key": "entityType", "value": "CUSTOMER", "type": "text"},
                {"key": "entityId", "value": "customer-uuid-here", "type": "text"},
                {"key": "documentType", "value": "AADHAAR", "type": "text"}
              ]
            }
          }
        },
        {
          "name": "Get Documents by Entity",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/documents/:entityType/:entityId"
          }
        },
        {
          "name": "Download Document",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/documents/download/:id"
          }
        },
