            ],
            "url": "{{base_url}}/nominees",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"customer-uuid-here\",\n  \"name\": \"Nominee Name\",\n  \"phone\": \"9876543210\",\n  \"relationship\": \"Spouse\",\n  \"address\": \"Nominee Address\",\n  \"dob\": \"1995-01-01\"\n}"
            }
          }
        },
        {
          "name": "Get Nominees by Customer",
